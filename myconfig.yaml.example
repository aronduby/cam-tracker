# kamtron_track_motion.py config file, generated by --write-config.
# Edit these values, then run with: kamtron_track_motion.py --config myconfig.yaml
# Any option here can still be overridden on the command line.
#
# host, user, password, and pan-max have no built-in default -- you must
# fill those in yourself (pan-max requires calibration, see the module
# docstring).

# Camera IP/hostname (required, directly or via --config)
host: null

# Camera login username (required, directly or via --config)
user: null

# Camera login password (required, directly or via --config)
password: null

# Leftmost allowed pan position, in control_ptz units (default 0 = home)
pan-min: 150

# Rightmost allowed pan position, in control_ptz units -- calibrate this
# yourself, see the module docstring (required, directly or via --config)
pan-max: 330

# Tilt (vertical) position to move to on startup, relative to home, in
# control_ptz units (default 0 = don't tilt away from home). This is set once at
# startup and held fixed -- tracking only pans.
y: 100

# Pan motor speed (default 60)
speed-x: 90

# Tilt motor speed, used only for the startup move to --y (default 60)
speed-y: 60

# How many pan units to move per full-frame-width of motion offset (default 120
# -- raise for bigger steps, lower for gentler tracking)
gain: 120.0

# Ignore motion within this fraction of center (0-1) to avoid jitter (default
# 0.15)
deadzone: 0.15

# Fraction of the frame that must change to count as real motion, not noise
# (default 0.02 = 2% of pixels)
min-motion-fraction: 0.02

# Per-pixel brightness change (0-255) to count as 'changed' (default 25)
pixel-threshold: 25.0

# Seconds between snapshots while watching for motion (default 0.5)
poll-interval: 0.5

# Minimum seconds between pan commands, so the motor isn't spammed and frames
# have time to settle after a move (default 2.0)
cooldown: 1

# Seconds to wait after issuing a pan command before trusting the next frame
# diff again (avoids mistaking the pan itself for motion)
settle-time: .5

# After this many consecutive poll rounds with no motion at all, pan back to the
# middle of [--pan-min, --pan-max]. Set to 0 to disable (default 10)
recenter-after: 10

# Don't send the camera home at startup, and don't move to --pan-min/--y either
# -- assume it's already positioned correctly and skip straight to tracking
no-home: false

# Seconds to wait after the startup home command before starting to track (a
# full-range move takes longer than a small nudge)
home-settle-time: 6.0

# Seconds to wait after moving to the initial (--pan-min, --y) position before
# starting to track (default 3.0)
initial-position-settle-time: 3.0
